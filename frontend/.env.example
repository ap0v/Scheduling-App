# Used by Next.js on the server to proxy browser /api requests to Spring Boot.
BACKEND_ORIGIN=http://localhost:8080

# Public Supabase browser configuration. Use your project URL and publishable
# (or legacy anon) key; never put a service-role key in this file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
